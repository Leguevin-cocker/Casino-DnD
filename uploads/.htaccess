# Les images envoyées ne doivent jamais être exécutées
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml
<FilesMatch "\.(php|phtml|phar|php\d)$">
  Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
